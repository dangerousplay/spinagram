{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene",
  "type": "object",
  "properties": {
    "background": {
      "type": "string"
    },
    "containers": {
      "description": "Row and column containers. Written only when there are some.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContainerInfo"
      }
    },
    "height": {
      "type": "number",
      "format": "double"
    },
    "id": {
      "type": "string"
    },
    "item_facts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "meta_tooltips": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "slug": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": true
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "width": {
      "type": "number",
      "format": "double"
    },
    "zones": {
      "description": "Zones with the ids the spec declares. Written only when there are zones.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ZoneInfo"
      }
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "slug",
    "width",
    "height",
    "background",
    "items",
    "item_facts",
    "sources",
    "meta_tooltips"
  ],
  "$defs": {
    "Align": {
      "description": "Horizontal alignment of a label.",
      "oneOf": [
        {
          "description": "Text starts at the box's left edge.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Text is centred in the box.",
          "type": "string",
          "const": "center"
        }
      ]
    },
    "Axis": {
      "description": "The direction of a container.",
      "oneOf": [
        {
          "description": "Members side by side (`rows:`).",
          "type": "string",
          "const": "row"
        },
        {
          "description": "Members stacked (`columns:`).",
          "type": "string",
          "const": "column"
        }
      ]
    },
    "Binding": {
      "type": "object",
      "properties": {
        "explicit": {
          "description": "The author fixed the side (`node.side`): routers keep it. Written only when true; absent means false.",
          "type": "boolean"
        },
        "frac": {
          "type": "number",
          "format": "double"
        },
        "shape_id": {
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "target": {
          "$ref": "#/$defs/EndpointTarget"
        }
      },
      "required": [
        "shape_id",
        "side",
        "frac",
        "target"
      ]
    },
    "Cell": {
      "type": "object",
      "properties": {
        "block": {
          "$ref": "#/$defs/TextBlock"
        },
        "bold": {
          "type": "boolean"
        },
        "fill": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Icon"
            },
            {
              "type": "null"
            }
          ]
        },
        "pad_left": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "block",
        "pad_left",
        "bold"
      ]
    },
    "Connector": {
      "type": "object",
      "properties": {
        "arrow_end": {
          "type": "boolean"
        },
        "arrow_start": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "dash": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "dashed": {
          "type": "boolean"
        },
        "dst": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaggedShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "marker_end": {
          "$ref": "#/$defs/MarkerKind"
        },
        "marker_start": {
          "$ref": "#/$defs/MarkerKind"
        },
        "opacity": {
          "type": "number",
          "format": "double"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 2,
            "minItems": 2
          }
        },
        "route": {
          "$ref": "#/$defs/ConnectorRoute"
        },
        "src": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "points",
        "route",
        "color",
        "width",
        "dashed",
        "arrow_start",
        "arrow_end",
        "marker_start",
        "marker_end",
        "opacity"
      ]
    },
    "ConnectorRoute": {
      "description": "How a connector's points are joined.",
      "oneOf": [
        {
          "description": "One straight segment.",
          "type": "string",
          "const": "straight"
        },
        {
          "description": "A polyline.",
          "type": "string",
          "const": "poly"
        },
        {
          "description": "A quadratic curve through three points.",
          "type": "string",
          "const": "curve"
        }
      ]
    },
    "ContainerInfo": {
      "description": "A `rows`/`columns` container (`row0`, `column1`, ...): axis, member node ids in order, and the box\n`[x, y, w, h]` enclosing the members.",
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/$defs/Axis"
        },
        "box": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "id": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "axis",
        "members",
        "box"
      ]
    },
    "EndpointTarget": {
      "description": "What an edge end points at.",
      "oneOf": [
        {
          "description": "A node.",
          "type": "string",
          "const": "node"
        },
        {
          "description": "A zone (`zone:` prefix).",
          "type": "string",
          "const": "zone"
        }
      ]
    },
    "Font": {
      "type": "object",
      "properties": {
        "fallback": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "figma_style": {
          "type": "string"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "italic": {
          "type": "boolean"
        },
        "size": {
          "type": "number",
          "format": "double"
        },
        "weight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "family",
        "weight",
        "italic",
        "size",
        "fallback",
        "figma_style"
      ]
    },
    "Icon": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "format": "double"
        },
        "w": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "path",
        "x",
        "y",
        "size"
      ]
    },
    "Image": {
      "type": "object",
      "properties": {
        "h": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "w": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "path",
        "x",
        "y",
        "w",
        "h"
      ]
    },
    "Item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "shape"
            }
          },
          "$ref": "#/$defs/Shape",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "connector"
            }
          },
          "$ref": "#/$defs/Connector",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "$ref": "#/$defs/Text",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "line"
            }
          },
          "$ref": "#/$defs/Line",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "$ref": "#/$defs/Image",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table"
            }
          },
          "$ref": "#/$defs/Table",
          "required": [
            "type"
          ]
        }
      ]
    },
    "Label": {
      "type": "object",
      "properties": {
        "align": {
          "$ref": "#/$defs/Align"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextBlock"
          }
        },
        "box": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 4,
          "minItems": 4
        },
        "gap": {
          "type": "number",
          "format": "double"
        },
        "valign": {
          "$ref": "#/$defs/VAlign"
        }
      },
      "required": [
        "blocks",
        "box",
        "align",
        "gap",
        "valign"
      ]
    },
    "Line": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x1": {
          "type": "number",
          "format": "double"
        },
        "x2": {
          "type": "number",
          "format": "double"
        },
        "y1": {
          "type": "number",
          "format": "double"
        },
        "y2": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "x1",
        "y1",
        "x2",
        "y2",
        "color",
        "width"
      ]
    },
    "LineCap": {
      "description": "The stroke line cap of a shape.",
      "oneOf": [
        {
          "description": "Flat ends.",
          "type": "string",
          "const": "butt"
        },
        {
          "description": "Rounded ends.",
          "type": "string",
          "const": "round"
        },
        {
          "description": "Square ends.",
          "type": "string",
          "const": "square"
        }
      ]
    },
    "MarkerKind": {
      "description": "The head drawn at a connector end.",
      "oneOf": [
        {
          "description": "A filled triangle.",
          "type": "string",
          "const": "arrow"
        },
        {
          "description": "An outlined chevron.",
          "type": "string",
          "const": "open-arrow"
        },
        {
          "description": "A filled diamond.",
          "type": "string",
          "const": "diamond"
        },
        {
          "description": "An outlined diamond.",
          "type": "string",
          "const": "open-diamond"
        },
        {
          "description": "A filled circle.",
          "type": "string",
          "const": "circle"
        },
        {
          "description": "A bar across the line.",
          "type": "string",
          "const": "bar"
        },
        {
          "description": "No head.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "Paint": {
      "description": "How a symbol part is painted.",
      "oneOf": [
        {
          "description": "Fill with the shape's fill and stroke with its stroke.",
          "type": "string",
          "const": "shape"
        },
        {
          "description": "Fill with the stroke colour.",
          "type": "string",
          "const": "solid"
        },
        {
          "description": "Outline only.",
          "type": "string",
          "const": "stroke"
        }
      ]
    },
    "Part": {
      "type": "object",
      "properties": {
        "d": {
          "type": "string"
        },
        "paint": {
          "$ref": "#/$defs/Paint"
        }
      },
      "required": [
        "d",
        "paint"
      ]
    },
    "Role": {
      "description": "What a shape is for; it picks the layer it is drawn in.",
      "oneOf": [
        {
          "description": "A diagram node.",
          "type": "string",
          "const": "node"
        },
        {
          "description": "A zone background.",
          "type": "string",
          "const": "zone"
        },
        {
          "description": "A pill.",
          "type": "string",
          "const": "pill"
        },
        {
          "description": "A legend swatch.",
          "type": "string",
          "const": "swatch"
        },
        {
          "description": "Frame and title furniture.",
          "type": "string",
          "const": "chrome"
        },
        {
          "description": "A panel.",
          "type": "string",
          "const": "panel"
        },
        {
          "description": "A badge or accent that belongs to a node.",
          "type": "string",
          "const": "node-part"
        },
        {
          "description": "A callout.",
          "type": "string",
          "const": "callout"
        }
      ]
    },
    "Run": {
      "description": "A piece of a line drawn with one font. `base`: it uses the block's own font (no fallback span).",
      "type": "object",
      "properties": {
        "base": {
          "type": "boolean"
        },
        "font": {
          "$ref": "#/$defs/Font"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "font",
        "base"
      ]
    },
    "Shape": {
      "type": "object",
      "properties": {
        "cap": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineCap"
            },
            {
              "type": "null"
            }
          ]
        },
        "dash": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "dashed": {
          "type": "boolean"
        },
        "fill": {
          "type": [
            "string",
            "null"
          ]
        },
        "fill_opacity": {
          "type": "number",
          "format": "double"
        },
        "h": {
          "type": "number",
          "format": "double"
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Icon"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ShapeKind"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "opacity": {
          "type": "number",
          "format": "double"
        },
        "parts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "radius": {
          "type": "number",
          "format": "double"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "shadow": {
          "description": "`(dx, dy, blur, colour, alpha)`",
          "type": [
            "array",
            "null"
          ],
          "maxItems": 5,
          "minItems": 5,
          "prefixItems": [
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "number",
              "format": "double"
            },
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "double"
            }
          ]
        },
        "stroke": {
          "type": [
            "string",
            "null"
          ]
        },
        "stroke_width": {
          "type": "number",
          "format": "double"
        },
        "w": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "w",
        "h",
        "stroke_width",
        "radius",
        "dashed",
        "opacity",
        "role",
        "fill_opacity"
      ]
    },
    "ShapeKind": {
      "description": "The kind of a shape: the node kind or `rect`, `pill` and the like. The kinds whose outline touches the box\nonly at side midpoints are named; any other kind is kept as written.",
      "type": "string"
    },
    "Side": {
      "description": "A side of a box. The declaration order is the order of `ports` and Python's dict order.",
      "oneOf": [
        {
          "description": "The upper edge.",
          "type": "string",
          "const": "top"
        },
        {
          "description": "The lower edge.",
          "type": "string",
          "const": "bottom"
        },
        {
          "description": "The left edge.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "The right edge.",
          "type": "string",
          "const": "right"
        }
      ]
    },
    "Table": {
      "type": "object",
      "properties": {
        "border": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Cell"
            }
          }
        },
        "col_widths": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "header_radius": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "row_heights": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "col_widths",
        "row_heights",
        "cells",
        "border",
        "header_radius"
      ]
    },
    "TaggedShape": {
      "description": "A shape nested in another item carries its own `type` tag, as in the item list.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "shape"
            }
          },
          "$ref": "#/$defs/Shape",
          "required": [
            "type"
          ]
        }
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/TextAnchor"
        },
        "block": {
          "$ref": "#/$defs/TextBlock"
        },
        "id": {
          "type": "string"
        },
        "letter_spacing": {
          "description": "Kept as written (int or float): the SVG writer prints it with Python's `str`.",
          "type": "number"
        },
        "width": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "block",
        "anchor",
        "letter_spacing"
      ]
    },
    "TextAnchor": {
      "description": "SVG `text-anchor` of a text item.",
      "oneOf": [
        {
          "description": "Text starts at x.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "Text is centred on x.",
          "type": "string",
          "const": "middle"
        },
        {
          "description": "Text ends at x.",
          "type": "string",
          "const": "end"
        }
      ]
    },
    "TextBlock": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "font": {
          "$ref": "#/$defs/Font"
        },
        "leading": {
          "type": "number",
          "format": "double"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Run"
            }
          }
        }
      },
      "required": [
